<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:padding="16dp">

    <LinearLayout
        android:id="@+id/lytHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginBottom="16dp">

        <TextView
            android:id="@+id/tvTituloPractica"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Práctica"
            android:textColor="#6D2BCE"
            android:textSize="28sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvSubtituloTema"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cargando tema..."
            android:textColor="#555555"
            android:textSize="16sp"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <Button
        android:id="@+id/btnEnviarRespuestas"
        android:layout_width="match_parent"
        android:layout_height="55dp"
        android:layout_alignParentBottom="true"
        android:layout_marginTop="12dp"
        android:backgroundTint="#6D2BCE"
        android:text="ENVIAR RESPUESTAS"
        android:textColor="#FFFFFF"
        android:textSize="16sp"
        android:textStyle="bold"
        app:cornerRadius="24dp" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvEjercicios"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/lytHeader"
        android:layout_above="@id/btnEnviarRespuestas"
        android:clipToPadding="false"
        android:paddingBottom="8dp" />

</RelativeLayout>