<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF"
    android:padding="24dp">

    <TextView
        android:id="@+id/tvTituloFelicitacion"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Examen completado :)"
        android:textColor="#6D2BCE"
        android:textSize="28sp"
        android:textStyle="bold"
        android:layout_marginTop="40dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cardScore"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="#FFFFFF"
        app:layout_constraintTop_toBottomOf="@id/tvTituloFelicitacion">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="32dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Tu Puntaje:"
                android:textColor="#000000"
                android:textSize="22sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvPuntajePorcentaje"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="33.33%"
                android:textColor="#3498DB"
                android:textSize="64sp"
                android:textStyle="bold"
                android:layout_marginTop="8dp" />

            <TextView
                android:id="@+id/tvResumenPreguntas"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Has acertado 4 de 12 preguntas."
                android:textColor="#7F8C8D"
                android:textSize="14sp"
                android:layout_marginTop="16dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nivel asignado:"
                android:textColor="#95A5A6"
                android:textSize="12sp"
                android:layout_marginTop="24dp" />

            <TextView
                android:id="@+id/tvNivelAsignado"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="PRINCIPIANTE"
                android:textColor="#2ECC71"
                android:textSize="26sp"
                android:textStyle="bold"
                android:layout_marginTop="4dp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <TextView
        android:id="@+id/tvInfoRuta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Basado en tu nivel hemos actualizado tu Ruta de Aprendizaje"
        android:gravity="center"
        android:textColor="#333333"
        android:textSize="13sp"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/cardScore" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:weightSum="2"
        android:layout_marginTop="24dp"
        app:layout_constraintTop_toBottomOf="@id/tvInfoRuta">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnRegresarInicio"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginEnd="8dp"
            android:background="#A569BD"
            android:text="Regresar al Inicio"
            android:textColor="#FFFFFF"
            android:textAllCaps="false" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnIrRuta"
            android:layout_width="0dp"
            android:layout_height="48dp"
            android:layout_weight="1"
            android:layout_marginStart="8dp"
            android:background="#6D2BCE"
            android:text="Ir a Ruta de Aprendizaje"
            android:textColor="#FFFFFF"
            android:textAllCaps="false" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>